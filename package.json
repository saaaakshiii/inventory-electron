{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Stock Pilot",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"pnpm dev:electron\"",
    "dev:electron": "pnpm transpile:electron && cross-env NODE_ENV=development electron .",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "build": "pnpm transpile:electron && vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "dist:linux": "pnpm build && electron-builder --linux --x64",
    "dist:win": "pnpm build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },

  "build": {
  "appId": "com.inventorymanagement.system",
  "productName": "Stock Pilot",
  "artifactName": "Stock.Pilot.${version}.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "msi",
        "arch": ["x64"]
      }
    ]
  }
  }
}
